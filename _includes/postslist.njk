{% for post in postslist %}
<article class="blog-posts-list">
        <div class="post-wrap">
            <strong>
                <a href="{{ post.url | url }}" class="blog-title">{{ post.data.title }}</a>
            </strong>
            <time datetime="{{ post.date }}" class="ghost">{{ post.date }}</time>
            <span style="color: var(--secondary-color);">{{ post.data.description }}</span>
        </div>
</article>
  {% endfor %}  